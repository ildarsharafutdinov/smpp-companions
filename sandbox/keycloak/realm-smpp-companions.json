{
  "realm": "smpp-companions",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "clients": [
    {
      "clientId": "smpp-client-confidential",
      "name": "SMPP Confidential — ROPC (DAG), client_secret; mirrors the test-tier KeycloakFixture realm shape (proxy/src/test/resources/keycloak/realm-smpp-companions.json)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["https://localhost:8443/*"],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-client-self",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "smpp-client-confidential",
            "included.custom.audience": "smpp-client-confidential",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "usr1",
      "enabled": true,
      "firstName": "Front",
      "lastName": "Bearerbox",
      "email": "usr1@sandbox.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "pwd1",
          "temporary": false
        }
      ]
    },
    {
      "username": "usr2",
      "enabled": true,
      "firstName": "Wrong",
      "lastName": "SmscCredential",
      "email": "usr2@sandbox.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "pwd2",
          "temporary": false
        }
      ]
    }
  ]
}
