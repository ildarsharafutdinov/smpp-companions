{
  "realm": "smpp-companions",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "clients": [
    {
      "clientId": "smpp-client-confidential",
      "name": "SMPP Confidential — ROPC (DAG) + RFC 7662 introspection (Story 2.1 paths 1/2/4)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "smpp-confidential-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["https://localhost:8443/*"],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-client-self",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "smpp-client-confidential",
            "included.custom.audience": "smpp-client-confidential",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "smpp-client-mtls",
      "name": "SMPP mTLS client — RFC 8705 tls_client_auth, ROPC WITHOUT client_secret (Story 2.1 path 3)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-x509",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["https://localhost:8443/*"],
      "webOrigins": [],
      "attributes": {
        "x509.subjectdn": "CN=smpp-mtls-client",
        "x509.casubjectdn": "CN=smpp-test-ca",
        "x509.allowregexcomparison": "false",
        "tls.client.certificate.bound.access.tokens": "false",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-client-self",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "smpp-client-mtls",
            "included.custom.audience": "smpp-client-mtls",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "testuser@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ]
    }
  ]
}
