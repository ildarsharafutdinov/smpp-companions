# bmad-loop orchestrator — run state, cache, local policy
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml

# BMad personal settings (intended to be gitignored; shared config is committed)
_bmad/config.user.yaml
_bmad/config.user.toml
_bmad/custom/*.user.toml

# Installed BMad skill library — regenerable tooling (reinstall via the bmad installer / bmad-loop init).
# .claude/settings.json (hooks) stays committed.
.claude/skills/

# Gradle / Java build outputs
.gradle/
build/
**/build/
out/
*.class

# Keep the Gradle wrapper committed (regenerable but intentionally tracked)
!gradle/wrapper/gradle-wrapper.jar

# IDE / OS
.idea/
*.iml
*.iws
.vscode/
.project
.classpath
.settings/
.DS_Store
